# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Clearframe

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-separate-admin-access-key

# ─── PostgreSQL / Prisma ───────────────────────────────────────────────
DATABASE_URL=postgresql://clearframe:clearframe@localhost:5432/clearframe?schema=public

# ─── Redis / BullMQ ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CONVERSION_QUEUE_NAME=conversion
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_SECONDS=10

# ─── Object storage ────────────────────────────────────────────────────
# "s3" uses MinIO / AWS S3 / any S3-compatible service in docker-compose.
# "filesystem" is a local-only adapter for tests and standalone development.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clearframe
S3_ACCESS_KEY_ID=clearframe
S3_SECRET_ACCESS_KEY=clearframe-dev-secret
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_ROOT=./storage

# ─── Limits and retention ──────────────────────────────────────────────
MAX_UPLOAD_BYTES=262144000
MAX_IMPORT_BYTES=262144000
MAX_BATCH_FILES=8
MAX_MEDIA_DURATION_SECONDS=7200
MAX_VIDEO_PIXELS=33177600
FFPROBE_TIMEOUT_MS=20000
FFMPEG_TIMEOUT_MS=3600000
RETENTION_HOURS=24
DOWNLOAD_URL_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOADS_PER_WINDOW=12
RATE_LIMIT_IMPORTS_PER_WINDOW=8
RATE_LIMIT_JOBS_PER_WINDOW=30

# Optional absolute paths. Docker Compose uses its system FFmpeg binaries.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ─── Docker Compose local-service credentials (development only) ─────────
# Compose overrides network endpoints to postgres/redis/minio service names.
POSTGRES_PASSWORD=clearframe
MINIO_ROOT_USER=clearframe
MINIO_ROOT_PASSWORD=clearframe-dev-secret

# ─── Optional verification settings ─────────────────────────────────────
# DOWNLOAD_SECRET can override the HMAC key used for object links.
# DOWNLOAD_SECRET=replace-with-a-separate-32-byte-random-key
# APP_URL=http://127.0.0.1:3000
# PG_DATA_DIR=/tmp/clearframe-pgdata
# PGPORT=55432
