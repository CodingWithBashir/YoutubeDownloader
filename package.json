{
  "name": "clearframe",
  "version": "1.0.0",
  "private": true,
  "description": "Clearframe \u2014 a guest-first, legally authorized media conversion studio.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx worker/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "prisma:migrate": "node scripts/apply-sql-migrations.mjs",
    "prisma:studio": "prisma studio",
    "dev:web": "next dev -H 0.0.0.0",
    "dev:worker": "tsx watch worker/index.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:embedded": "node scripts/embedded-postgres.mjs",
    "db:apply": "node scripts/apply-sql-migrations.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "busboy": "1.6.0",
    "clsx": "2.1.1",
    "ioredis": "5.8.2",
    "ipaddr.js": "2.2.0",
    "lucide-react": "0.545.0",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "2.6.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/busboy": "1.5.4",
    "@types/node": "22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "25.0.1",
    "pg": "^8.23.1",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
